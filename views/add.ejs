<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Add Book - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1><%= __('add_book') %></h1>
        <nav>
            <a href="/?lang=<%= locale %>" class="button"><%= __('home') %></a>
            <span class="user">Welcome, <%= username %></span>
            <a href="/dashboard?lang=<%= locale %>" class="button"><%= __('dashboard') %></a>
            <a href="/profile?lang=<%= locale %>" class="button"><%= __('profile') %></a>
            <a href="/reports?lang=<%= locale %>" class="button"><%= __('reports') %></a>
            <a href="/logout" class="button"><%= __('logout') %></a>
            <span class="lang"><a href="?lang=en">EN</a> | <a href="?lang=id">ID</a></span>
        </nav>
    </header>
    <form method="post" action="/add?lang=<%= locale %>" enctype="multipart/form-data">
        <label><%= __('title') %>:<br><input type="text" name="title" required></label>
        <label><%= __('author') %>:<br><input type="text" name="author" required></label>
        <label><%= __('year') %>:<br><input type="number" name="year"></label>
        <label><%= __('genre') %>:<br>
            <select name="genre">
                <% categories.forEach(function(g){ %>
                    <option value="<%= g %>"><%= g %></option>
                <% }) %>
            </select>
        </label>
        <label><%= __('status') %>:<br>
            <select name="status">
                <% statuses.forEach(function(s){ %>
                    <option value="<%= s %>"><%= s %></option>
                <% }) %>
            </select>
        </label>
        <label><%= __('isbn') %>:<br><input type="text" name="isbn"></label>
        <label><%= __('description') %>:<br><textarea name="description"></textarea></label>
        <label><%= __('image') %>:<br><input type="file" name="image"></label>
        <button type="submit"><%= __('add') %></button>
    </form>
</div>
</body>
</html>
