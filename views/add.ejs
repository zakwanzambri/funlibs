<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Add Book - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>Add Book</h1>
        <nav>
            <a href="/" class="button">Home</a>
            <span class="user">Welcome, <%= username %></span>
            <a href="/dashboard" class="button">Dashboard</a>
            <a href="/profile" class="button">Profile</a>
            <a href="/logout" class="button">Logout</a>
        </nav>
    </header>
    <form method="post" action="/add">
        <label>Title:<br><input type="text" name="title" required></label>
        <label>Author:<br><input type="text" name="author" required></label>
        <label>Year:<br><input type="number" name="year"></label>
        <label>Genre:<br>
            <select name="genre">
                <% categories.forEach(function(g){ %>
                    <option value="<%= g %>"><%= g %></option>
                <% }) %>
            </select>
        </label>
        <label>Status:<br>
            <select name="status">
                <% statuses.forEach(function(s){ %>
                    <option value="<%= s %>"><%= s %></option>
                <% }) %>
            </select>
        </label>
        <label>ISBN:<br><input type="text" name="isbn"></label>
        <label>Description:<br><textarea name="description"></textarea></label>
        <label>Image URL:<br><input type="text" name="image"></label>
        <button type="submit">Add</button>
    </form>
</div>
</body>
</html>
