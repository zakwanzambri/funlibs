<%- include('partials/head', { title: 'Reset Password - PustakaPro', locale, userId, username, role, __ }) %>
<form method="post" action="/reset" class="max-w-sm mx-auto space-y-2">
    <label class="form-control w-full">
        <span class="label-text">Email</span>
        <input type="text" name="email" class="input input-bordered" required>
    </label>
    <button type="submit" class="btn btn-primary w-full">Send Reset Link</button>
</form>
