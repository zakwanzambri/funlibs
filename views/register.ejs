<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Register - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <%- include('partials/nav', { locale, userId, username, role, __ }) %>
    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>
    <form method="post" action="/register">
        <label>Username:<br><input type="text" name="username" required></label>
        <label>Password:<br><input type="password" name="password" required></label>
        <label>Email:<br><input type="text" name="email" required></label>
        <label>Contact:<br><input type="text" name="contact"></label>
        <button type="submit">Register</button>
    </form>
</div>
</body>
</html>
