<%- include('partials/head', { title: book.title + ' - PustakaPro', locale, userId, username, role, __ }) %>
<% if (error) { %><script>window.flashMsg="<%= error %>"</script><% } %>
<div class="max-w-2xl mx-auto">
    <% if(book.image){ %>
        <figure class="mb-4"><img src="<%= book.image %>" alt="" class="w-full" /></figure>
    <% } %>
    <p><strong>Author:</strong> <%= book.author %></p>
    <p><strong>Year:</strong> <%= book.year %></p>
    <p><strong>Genre:</strong> <%= book.genre %></p>
    <p><strong>Status:</strong> <%= book.status %></p>
    <p><strong>ISBN:</strong> <%= book.isbn %></p>
    <% if (book.description) { %>
        <p><strong>Description:</strong> <%= book.description %></p>
    <% } %>
    <% if (userId && book.status === 'Available') { %>
        <p><a href="/borrow/<%= book.id %>?lang=<%= locale %>" class="btn btn-primary mt-2">Borrow this book</a></p>
    <% } %>
    <% if(avg){ %>
        <p class="mt-4"><strong>Average Rating:</strong> <%= avg %>/5</p>
    <% } %>
    <h2 class="text-xl mt-4 mb-2">Reviews</h2>
    <ul class="space-y-1">
        <% reviews.forEach(function(r){ %>
            <li><strong><%= r.reviewer %></strong> rated <%= r.rating %>/5 - <%= r.comment %></li>
        <% }) %>
    </ul>
    <h3 class="text-lg mt-4">Add Review</h3>
    <form method="post" action="/book/<%= book.id %>/review?lang=<%= locale %>" class="space-y-2">
        <label class="form-control w-full">
            <span class="label-text">Name</span>
            <input type="text" name="reviewer" class="input input-bordered" required>
        </label>
        <label class="form-control w-full">
            <span class="label-text">Rating</span>
            <input type="number" name="rating" min="1" max="5" class="input input-bordered" required>
        </label>
        <label class="form-control w-full">
            <span class="label-text">Comment</span>
            <input type="text" name="comment" class="input input-bordered" required>
        </label>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>
<%- include('partials/foot', { locale, userId, username, role, __ }) %>
