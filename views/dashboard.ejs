<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Dashboard - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>Your Borrowed Books</h1>
        <nav>
            <a href="/" class="button">Home</a>
            <span class="user">Welcome, <%= username %></span>
            <a href="/profile" class="button">Profile</a>
            <% if (role === 'Librarian') { %>
                <a href="/reports" class="button">Reports</a>
            <% } %>
            <a href="/logout" class="button">Logout</a>
        </nav>
    </header>
    <% if (books.length === 0) { %>
        <p>No books borrowed.</p>
    <% } else { %>
    <table>
        <tr><th>Title</th><th>Author</th><th>Due Date</th><th>Fine</th><th>Action</th></tr>
        <% books.forEach(function(b){ %>
        <tr class="<%= b.overdue ? 'overdue' : '' %>">
            <td><%= b.title %></td>
            <td><%= b.author %></td>
            <td><%= new Date(b.due_date).toLocaleDateString() %></td>
            <td><%= b.fine %></td>
            <td><a href="/return/<%= b.id %>" class="button">Return</a></td>
        </tr>
        <% }) %>
    </table>
    <% } %>

    <% if (reservations.length) { %>
        <h2>Your Reservations</h2>
        <table>
            <tr><th>Title</th><th>Status</th><th>Action</th></tr>
            <% reservations.forEach(function(r){ %>
            <tr>
                <td><%= r.title %></td>
                <td><%= r.status %></td>
                <td>
                    <% if (r.status === 'Reserved') { %>
                        <a href="/borrow/<%= r.id %>" class="button">Borrow</a>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </table>
    <% } %>
</div>
</body>
</html>
