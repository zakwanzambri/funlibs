<%- include('partials/head', { title: 'Dashboard - PustakaPro', locale, userId, username, role, __ }) %>
<% if (error) { %><script>window.flashMsg="<%= error %>"</script><% } %>
<h2 class="text-xl mb-2"><%= __('dashboard') %></h2>
<% if (books.length === 0) { %>
    <p>No books borrowed.</p>
<% } else { %>
<table class="table w-full mb-4">
    <thead>
        <tr><th>Title</th><th>Author</th><th>Due Date</th><th>Fine</th><th></th></tr>
    </thead>
    <tbody>
    <% books.forEach(function(b){ %>
        <tr class="<%= b.overdue ? 'text-error' : '' %>">
            <td><%= b.title %></td>
            <td><%= b.author %></td>
            <td><%= new Date(b.due_date).toLocaleDateString() %></td>
            <td><%= b.fine %></td>
            <td><a href="/return/<%= b.id %>" class="btn btn-xs">Return</a></td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% } %>
<% if (reservations.length) { %>
<h2 class="text-xl mt-4 mb-2">Your Reservations</h2>
<table class="table w-full">
    <thead>
        <tr><th>Title</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    <% reservations.forEach(function(r){ %>
        <tr>
            <td><%= r.title %></td>
            <td><%= r.status %></td>
            <td>
                <% if (r.status === 'Reserved') { %>
                <a href="/borrow/<%= r.id %>" class="btn btn-xs">Borrow</a>
                <% } %>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% } %>
<%- include('partials/foot', { locale, userId, username, role, __ }) %>
