<%- include('partials/head', { title: 'Members - PustakaPro', locale, userId, username, role, __ }) %>
<h2 class="text-xl mb-2">Members</h2>
<table class="table w-full">
  <thead><tr><th>Username</th><th>Email</th><th>Contact</th><th>Role</th></tr></thead>
  <tbody>
  <% members.forEach(function(m){ %>
    <tr>
      <td><%= m.username %></td>
      <td><%= m.email %></td>
      <td><%= m.contact %></td>
      <td><%= m.role %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<%- include('partials/foot', { locale, userId, username, role, __ }) %>
