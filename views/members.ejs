<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Members - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <%- include('partials/nav', { locale, userId, username, role, __ }) %>
    <table>
        <tr><th>Username</th><th>Email</th><th>Contact</th><th>Role</th></tr>
        <% members.forEach(function(m){ %>
        <tr>
            <td><%= m.username %></td>
            <td><%= m.email %></td>
            <td><%= m.contact %></td>
            <td><%= m.role %></td>
        </tr>
        <% }) %>
    </table>
</div>
</body>
</html>
