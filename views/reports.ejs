<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Reports - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>Library Reports</h1>
        <nav>
            <a href="/" class="button">Home</a>
            <span class="user">Welcome, <%= username %></span>
            <a href="/dashboard" class="button">Dashboard</a>
            <a href="/profile" class="button">Profile</a>
            <a href="/add" class="button">Add Book</a>
            <a href="/reports" class="button">Reports</a>
            <a href="/logout" class="button">Logout</a>
        </nav>
    </header>
    <p>Total Books: <%= stats.books %></p>
    <p>Total Users: <%= stats.users %></p>
    <p>Books Borrowed: <%= stats.borrowed %></p>
    <p>Overdue Loans: <%= stats.overdue %></p>
    <ul>
        <li><a href="/reports/popular">Book Popularity</a></li>
        <li><a href="/reports/overdue">Overdue Books</a></li>
        <li><a href="/reports/activity">User Activity Logs</a></li>
    </ul>
</div>
</body>
</html>
