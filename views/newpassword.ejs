<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Set New Password - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <%- include('partials/nav', { locale, userId, username, role, __ }) %>
    <form method="post" action="/reset/<%= token %>">
        <label>New Password:<br><input type="password" name="password" required></label>
        <button type="submit">Update</button>
    </form>
</div>
</body>
</html>
