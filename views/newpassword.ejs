<%- include('partials/head', { title: 'Set New Password - PustakaPro', locale, userId, username, role, __ }) %>
<form method="post" action="/reset/<%= token %>" class="max-w-sm mx-auto space-y-2">
    <label class="form-control w-full">
        <span class="label-text">New Password</span>
        <input type="password" name="password" class="input input-bordered" required>
    </label>
    <button type="submit" class="btn btn-primary w-full">Update</button>
</form>
<%- include('partials/foot', { locale, userId, username, role, __ }) %>
