<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>PustakaPro Library</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <header>
        <h1>PustakaPro</h1>
        <nav>
            <a href="/?lang=<%= locale %>" class="button"><%= __('home') %></a>
            <% if (userId) { %>
                <span class="user">Welcome, <%= username %></span>
                <a href="/dashboard?lang=<%= locale %>" class="button"><%= __('dashboard') %></a>
                <a href="/profile?lang=<%= locale %>" class="button"><%= __('profile') %></a>
                <% if (role === 'Librarian') { %>
                    <a href="/add?lang=<%= locale %>" class="button"><%= __('add_book') %></a>
                    <a href="/reports?lang=<%= locale %>" class="button"><%= __('reports') %></a>
                <% } %>
                <a href="/logout" class="button"><%= __('logout') %></a>
            <% } else { %>
                <a href="/login?lang=<%= locale %>" class="button"><%= __('login') %></a>
                <a href="/register?lang=<%= locale %>" class="button"><%= __('register') %></a>
            <% } %>
            <span class="lang">
                <a href="?lang=en">EN</a> | <a href="?lang=id">ID</a>
            </span>
        </nav>
    </header>
    <form method="get" action="/">
        <input type="hidden" name="lang" value="<%= locale %>">
        <input type="text" name="q" value="<%= query %>" placeholder="<%= __('search') %>">
        <select name="genre">
            <option value=""><%= __('all_genres') %></option>
            <% categories.forEach(function(g){ %>
                <option value="<%= g %>" <%= genre===g? 'selected': '' %>><%= g %></option>
            <% }) %>
        </select>
        <select name="status">
            <option value=""><%= __('any_status') %></option>
            <% statuses.forEach(function(s){ %>
                <option value="<%= s %>" <%= status===s? 'selected': '' %>><%= s %></option>
            <% }) %>
        </select>
        <button type="submit"><%= __('search') %></button>
    </form>
    <table>
        <tr><th>Image</th><th>Title</th><th>Author</th><th>Year</th><th>Genre</th><th>Status</th><th>ISBN</th><th>Description</th><th>Actions</th></tr>
        <% books.forEach(function(book){ %>
            <tr>
                <td><% if(book.image){ %><img src="<%= book.image %>" alt="" width="40"><% } %></td>
                <td><a href="/book/<%= book.id %>?lang=<%= locale %>"><%= book.title %></a></td>
                <td><%= book.author %></td>
                <td><%= book.year %></td>
                <td><%= book.genre %></td>
                <td><%= book.status %></td>
                <td><%= book.isbn %></td>
                <td><%= book.description ? book.description.substring(0,40) : '' %></td>
                <td>
                    <% if (userId) { %>
                        <% if (role === 'Librarian') { %>
                            <a href="/edit/<%= book.id %>" class="button">Edit</a>
                            <form action="/delete/<%= book.id %>" method="post" class="inline">
                                <button type="submit">Delete</button>
                            </form>
                        <% } %>
                        <% if (book.status === 'Checked Out') { %>
                            <a href="/reserve/<%= book.id %>" class="button">Reserve</a>
                        <% } else { %>
                            <a href="/borrow/<%= book.id %>" class="button">Borrow</a>
                        <% } %>
                    <% } %>
                </td>
            </tr>
        <% }); %>
    </table>
</div>
</body>
</html>
