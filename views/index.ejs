<%- include('partials/head', { title: 'PustakaPro Library', locale, userId, username, role, __ }) %>
<% if (error) { %><script>window.flashMsg="<%= error %>"</script><% } %>
<form method="get" action="/" class="flex flex-wrap gap-2 mb-4">
    <input type="hidden" name="lang" value="<%= locale %>">
    <input type="text" name="q" value="<%= query %>" placeholder="<%= __('search') %>" class="input input-bordered">
    <select name="genre" class="select select-bordered">
        <option value=""><%= __('all_genres') %></option>
        <% categories.forEach(function(g){ %>
            <option value="<%= g %>" <%= genre===g? 'selected': '' %>><%= g %></option>
        <% }) %>
    </select>
    <select name="status" class="select select-bordered">
        <option value=""><%= __('any_status') %></option>
        <% statuses.forEach(function(s){ %>
            <option value="<%= s %>" <%= status===s? 'selected': '' %>><%= s %></option>
        <% }) %>
    </select>
    <button type="submit" class="btn btn-primary"><%= __('search') %></button>
</form>
<div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
    <% books.forEach(function(book){ %>
    <div class="card bg-base-100 shadow">
        <% if(book.image){ %><figure><img src="<%= book.image %>" alt="" class="h-48 w-full object-cover" /></figure><% } %>
        <div class="card-body">
            <h2 class="card-title"><a href="/book/<%= book.id %>?lang=<%= locale %>"><%= book.title %></a></h2>
            <p><%= book.author %></p>
            <p><span class="badge"><%= book.status %></span></p>
            <div class="card-actions justify-end">
            <% if (userId) { %>
                <% if (role === 'Librarian') { %>
                <a href="/edit/<%= book.id %>" class="btn btn-sm"><i class="fa fa-edit"></i></a>
                <form action="/delete/<%= book.id %>" method="post" onsubmit="return confirmDelete(this)" class="inline">
                    <button type="submit" class="btn btn-sm btn-error"><i class="fa fa-trash"></i></button>
                </form>
                <% } %>
                <% if (book.status === 'Checked Out') { %>
                <a href="/reserve/<%= book.id %>" class="btn btn-sm"><i class="fa fa-bookmark"></i></a>
                <% } else { %>
                <a href="/borrow/<%= book.id %>" class="btn btn-sm btn-success"><i class="fa fa-book"></i></a>
                <% } %>
            <% } %>
            </div>
        </div>
    </div>
    <% }) %>
</div>
<script>
function confirmDelete(form){
    event.preventDefault();
    Swal.fire({title:'Delete?',icon:'warning',showCancelButton:true}).then(r=>{if(r.isConfirmed) form.submit();});
    return false;
}
</script>
<%- include('partials/foot', { locale, userId, username, role, __ }) %>
