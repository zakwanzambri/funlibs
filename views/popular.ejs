<%- include('partials/head', { title: 'Book Popularity - PustakaPro', locale, userId, username, role, __ }) %>
<h2 class="text-xl mb-2">Book Popularity</h2>
<table class="table w-full">
  <thead><tr><th>Title</th><th>Times Borrowed</th></tr></thead>
  <tbody>
  <% books.forEach(function(b){ %>
    <tr><td><%= b.title %></td><td><%= b.count %></td></tr>
  <% }) %>
  </tbody>
</table>
<%- include('partials/foot', { locale, userId, username, role, __ }) %>
