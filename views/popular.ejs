<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Book Popularity - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <%- include('partials/nav', { locale, userId, username, role, __ }) %>
    <table>
        <tr><th>Title</th><th>Times Borrowed</th></tr>
        <% books.forEach(function(b){ %>
            <tr><td><%= b.title %></td><td><%= b.count %></td></tr>
        <% }) %>
    </table>
</div>
</body>
</html>
