<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Book - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Edit Book</h1>
    <form method="post" action="/edit/<%= book.id %>">
        <label>Title: <input type="text" name="title" value="<%= book.title %>" required></label><br>
        <label>Author: <input type="text" name="author" value="<%= book.author %>" required></label><br>
        <label>Year: <input type="number" name="year" value="<%= book.year %>"></label><br>
        <button type="submit">Save</button>
    </form>
    <a href="/">Back</a>
</body>
</html>
