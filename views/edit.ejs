<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Edit Book - PustakaPro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="container">
    <%- include('partials/nav', { locale, userId, username, role, __ }) %>
    <form method="post" action="/edit/<%= book.id %>?lang=<%= locale %>" enctype="multipart/form-data">
        <label><%= __('title') %>:<br><input type="text" name="title" value="<%= book.title %>" required></label>
        <label><%= __('author') %>:<br><input type="text" name="author" value="<%= book.author %>" required></label>
        <label><%= __('year') %>:<br><input type="number" name="year" value="<%= book.year %>"></label>
        <label><%= __('genre') %>:<br>
            <select name="genre">
                <% categories.forEach(function(g){ %>
                    <option value="<%= g %>" <%= book.genre===g? 'selected': '' %>><%= g %></option>
                <% }) %>
            </select>
        </label>
        <label><%= __('status') %>:<br>
            <select name="status">
                <% statuses.forEach(function(s){ %>
                    <option value="<%= s %>" <%= book.status===s? 'selected': '' %>><%= s %></option>
                <% }) %>
            </select>
        </label>
        <label><%= __('isbn') %>:<br><input type="text" name="isbn" value="<%= book.isbn %>"></label>
        <label><%= __('description') %>:<br><textarea name="description"><%= book.description %></textarea></label>
        <label><%= __('image') %>:<br><input type="file" name="image"></label>
        <input type="hidden" name="currentImage" value="<%= book.image %>">
        <button type="submit"><%= __('save') %></button>
    </form>
</div>
</body>
</html>
